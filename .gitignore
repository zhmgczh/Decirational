# IDE project files (IntelliJ) - machine/user-specific, not meant to be shared
.idea/
*.iml

# A per-clone git config belongs in .git/config or the user's own
# ~/.gitconfig, never inside the tracked working tree - git never reads it
# from here, so a copy checked in at this path does nothing but confuse.
.gitconfig
